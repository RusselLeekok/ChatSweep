{
  "manifest_version": 3,
  "name": "ChatTidy",
  "version": "0.4.3",
  "description": "在 ChatGPT、Grok、Gemini、DeepSeek 和豆包中批量选择并删除当前可见的聊天。",
  "icons": {
    "16": "icons/chattidy-16.png",
    "32": "icons/chattidy-32.png",
    "48": "icons/chattidy-48.png",
    "128": "icons/chattidy-128.png"
  },
  "permissions": ["activeTab", "scripting"],
  "action": {
    "default_title": "ChatTidy",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/chattidy-16.png",
      "32": "icons/chattidy-32.png",
      "48": "icons/chattidy-48.png",
      "128": "icons/chattidy-128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://grok.com/*",
        "https://gemini.google.com/*",
        "https://chat.deepseek.com/*",
        "https://www.doubao.com/*",
        "https://doubao.com/*"
      ],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
